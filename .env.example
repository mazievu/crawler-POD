# Apify API Token
# Get yours at: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Optional API credentials
PINTEREST_TOKEN=your_pinterest_token

# Local runtime services
SEARXNG_URL=http://localhost:8888
SEARXNG_BIND_HOST=127.0.0.1
CDP_URL=http://localhost:9222
CDP_USER_DATA_DIR=data/cdp-profile

# Server port
PORT=3000

# Runtime Dependencies
CDP_URL=http://localhost:9222
SEARXNG_URL=http://localhost:8080
DEPENDENCY_PROBE_TIMEOUT_MS=2000

# Required to encrypt marketplace browser session state and captured HTML at rest.
# Generate a distinct 32-byte base64 key, for example with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Docker Compose (change the secret before public deployment)
HOST_PORT=9999
SEARXNG_SECRET=replace-with-a-long-random-secret
# Optional: CDP endpoint accessible from the collector container.
# DOCKER_CDP_URL=http://host.docker.internal:9222
